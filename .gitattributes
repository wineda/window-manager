# ウィンドウ整理ツール(第3章「ファイル構成」に対応)

# 本体とモジュール: UTF-8(BOM なし)・CRLF
*.ahk text eol=crlf

# 設定: 作業ツリーは UTF-16 LE(BOM付き)・CRLF。
# リポジトリ内では UTF-8 として持つため、INI の差分をテキストで確認できる。
claude_hotkey.ini text working-tree-encoding=UTF-16LE-BOM eol=crlf

# 操作ログのサンプル(docs/logging.md: CRLF)
*.csv text eol=crlf

# 資料・スクリプト
*.md text eol=lf
*.py text eol=lf
